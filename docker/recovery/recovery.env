# Foresight Radar — configuration of the ISOLATED recovery stack (docker-compose.recovery.yml).
# Mounted over /var/www/.env inside recovery_app, so the developer's own .env is never read there.
# Nothing here is a production secret: the database and key are local, throw-away values.
APP_NAME="Foresight Radar (recovery)"
APP_ENV=recovery
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_KEY=base64:cmVjb3Zlcnktb25seS1rZXktbm90LXByb2R1Y3Rpb24=
APP_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=recovery_mysql
DB_PORT=3306
DB_DATABASE=foresight_radar
DB_USERNAME=recovery
DB_PASSWORD=recovery-local-only

# No worker or scheduler runs in this stack: queued jobs are stored, never executed.
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
# config/cache.php reads CACHE_DRIVER (not Laravel 11's CACHE_STORE).
CACHE_DRIVER=array
CACHE_STORE=array
LOG_CHANNEL=stderr
LOG_STACK=stderr
MAIL_MAILER=array
VIEW_COMPILED_PATH=/tmp/views

# No external services.
SIGNAL_EXTRACTION_DRIVER=heuristic
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPS_ALERT_EMAIL=
