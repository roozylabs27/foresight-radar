# Foresight Radar — configuration of the ISOLATED browser E2E stack (docker-compose.e2e.yml).
# Mounted over /var/www/.env in e2e_app and e2e_worker; the developer's .env is never read there.
# Nothing here is a production secret: key, database and password are local, throw-away values.
APP_NAME="Foresight Radar (E2E)"
APP_ENV=e2e
APP_KEY=base64:X3dt7dXtmsOqnId76cPjAQvCnVmUGDfFuwvgne8NrNI=
APP_DEBUG=false
APP_URL=http://localhost:8091
APP_LOCALE=id

DB_CONNECTION=mysql
DB_HOST=e2e_mysql
DB_PORT=3306
DB_DATABASE=foresight_e2e
DB_USERNAME=e2e
DB_PASSWORD=e2e-local-only

# The worker runs queued AI jobs, so pending, done and failed states are real.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
# config/cache.php reads CACHE_DRIVER. File cache on the shared storage volume, so the app and the
# worker share job locks (ShouldBeUnique) like production does.
CACHE_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=stderr
LOG_STACK=stderr
MAIL_MAILER=array

# Deterministic AI test double (App\Services\Llm\E2eScriptedLlmClient); no external services.
LLM_PROVIDER=e2e
SIGNAL_EXTRACTION_DRIVER=heuristic
OPS_ALERT_EMAIL=

# Password of every E2E fixture account (database/seeders/E2eSeeder.php). Local only.
E2E_PASSWORD=E2e-24d0e47707b6e8ef68
