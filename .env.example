APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to true in HTTPS production environments (defaults to true if APP_ENV=production)
SESSION_SECURE_COOKIE=false
# Restrict open public self-registration (set to false in production enterprise environments)
AUTH_ALLOW_REGISTRATION=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Claude for signal extraction and scenario narratives (empty = no AI).
# Text sent to the API is described in docs/product/LLM_INTEGRATION.md.
# LLM provider: "anthropic" (Claude, the ANTHROPIC_* keys) or "openai_compatible"
# (any /chat/completions API, the OPENAI_COMPATIBLE_* keys).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_NARRATIVE_EFFORT=medium
ANTHROPIC_TIMEOUT=120
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_FALLBACKS=default
SIGNAL_EXTRACTION_DRIVER=llm
SIGNAL_EXTRACTION_MAX_CHARS=60000
SIGNAL_EXTRACTION_MAX_CANDIDATES=8

# OpenAI-compatible provider (LLM_PROVIDER=openai_compatible). Example: OpenRouter.
# Ollama: BASE_URL=http://host.docker.internal:11434/v1, ALLOW_NO_KEY=true, NAME=ollama.
# OpenCode Zen: BASE_URL=https://opencode.ai/inference/openai/v1, key from opencode.ai/console,
# NAME=opencode, and a Chat Completions model such as deepseek-v4-pro, glm-5.3 or kimi-k3.
# Gemini: BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, key from Google AI Studio,
# NAME=gemini, LABEL=Gemini, MODEL=gemini-3.8-flash (use STRUCTURED_OUTPUT=json_object if json_schema is rejected).
OPENAI_COMPATIBLE_NAME=openrouter
OPENAI_COMPATIBLE_LABEL=OpenRouter
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_STRUCTURED_OUTPUT=json_schema
OPENAI_COMPATIBLE_ALLOW_NO_KEY=false
